<resources>
    <!-- Base application theme. -->
    <style name="Theme.ByeDPI" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#5976DF</item>
        <item name="colorPrimaryVariant">#3C52A3</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#5976DF</item>
        <item name="colorSecondaryVariant">#3C52A3</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Viltrum" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/viltrum_gold</item>
        <item name="colorPrimaryVariant">@color/viltrum_red</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/viltrum_red</item>
        <item name="colorSecondaryVariant">@color/viltrum_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/viltrum_surface</item>
        <item name="android:colorBackground">@color/viltrum_background</item>
        <item name="android:windowBackground">@color/viltrum_background</item>
        <item name="android:statusBarColor">@color/viltrum_background</item>
    </style>
</resources>
